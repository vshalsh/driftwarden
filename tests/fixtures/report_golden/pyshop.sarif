            {
              "id": "forbid",
              "name": "ForbiddenTechnology",
              "shortDescription": {
                "text": "Code uses a technology an accepted ADR forbids"
              },
              "fullDescription": {
                "text": "An accepted architecture decision forbids this technology, and the repository uses it. The evidence lines were checked verbatim by a deterministic verifier."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "An accepted architecture decision forbids this technology, and the repository uses it. The evidence lines were checked verbatim by a deterministic verifier."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "require",
              "name": "RequiredTechnology",
              "shortDescription": {
                "text": "Code departs from a technology an accepted ADR requires"
              },
              "fullDescription": {
                "text": "An accepted architecture decision requires a technology; the repository is missing it or uses an alternative. The evidence lines were checked verbatim."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "An accepted architecture decision requires a technology; the repository is missing it or uses an alternative. The evidence lines were checked verbatim."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "only",
              "name": "OnlyAllowedTechnology",
              "shortDescription": {
                "text": "Code uses a technology outside the only one(s) an accepted ADR allows"
              },
              "fullDescription": {
                "text": "An accepted architecture decision allows only certain technologies in a category; the repository uses another one. The evidence lines were checked verbatim."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "An accepted architecture decision allows only certain technologies in a category; the repository uses another one. The evidence lines were checked verbatim."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "boundary",
              "name": "ModuleBoundary",
              "shortDescription": {
                "text": "Code crosses a boundary an accepted ADR sets"
              },
              "fullDescription": {
                "text": "An accepted architecture decision limits where a module or technology may be used; the repository uses it outside those paths. The evidence lines were checked verbatim."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "An accepted architecture decision limits where a module or technology may be used; the repository uses it outside those paths. The evidence lines were checked verbatim."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "free",
              "name": "FreeFormDecision",
              "shortDescription": {
                "text": "Code contradicts a free-form accepted ADR"
              },
              "fullDescription": {
                "text": "A judged free-form architecture decision does not hold. Every cited line was checked verbatim by a deterministic verifier."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "A judged free-form architecture decision does not hold. Every cited line was checked verbatim by a deterministic verifier."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "undocumented-decision",
              "name": "UndocumentedDecision",
              "shortDescription": {
                "text": "Architectural choice in the code that no ADR covers"
              },
              "fullDescription": {
                "text": "The repository uses a technology (datastore, queue, framework, cloud SDK...) that no ADR records. DriftWarden can draft the missing ADR (--draft-adrs)."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden",
              "help": {
                "text": "The repository uses a technology (datastore, queue, framework, cloud SDK...) that no ADR records. DriftWarden can draft the missing ADR (--draft-adrs)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "architecture",
                  "adr",
                  "drift"
                ]
              }
            },
            {
              "id": "could-not-verify",
              "name": "CouldNotVerify",
              "shortDescription": {
                "text": "A finding DriftWarden could not verify"
              },
              "fullDescription": {
                "text": "A decision, claim, verdict or evidence item failed its deterministic verifier. It is not a finding and is never shown as a violation; the reason is in the message."
              },
              "helpUri": "https://github.com/vshalsh/driftwarden#grounding--traceability",
              "help": {
                "text": "A decision, claim, verdict or evidence item failed its deterministic verifier. It is not a finding and is never shown as a violation; the reason is in the message."
